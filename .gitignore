# -------------------------
app_backup.py
temp_code.c
temp_patched.c
cppcheck_out.txt

# -------------------------
# Logs
# -------------------------
*.log

# -------------------------
# OS generated files
# -------------------------
.DS_Store
Thumbs.db
desktop.ini

# -------------------------
# Coverage / testing
# -------------------------
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/

# -------------------------
# Build / compiled files
